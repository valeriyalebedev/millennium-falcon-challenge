{
  "name": "millennium-falcon-challenge",
  "version": "1.0.0",
  "description": "Millenium falcon challenge solution",
  "main": "index.js",
  "workspaces": [
    "core",
    "backend",
    "frontend",
    "cli"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:debug": "concurrently \"npm run dev:backend:debug\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch backend/src/utils/server.ts",
    "dev:backend:debug": "tsx watch backend/src/utils/server.ts --inspect",
    "dev:frontend": "npm --prefix frontend start",
    "test": "npm run test:backend && npm run test:core && npm run test:frontend ",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:core": "npm --prefix core test",
    "build": "tsc -b core backend frontend cli",
    "build:core": "tsc -b core",
    "build:backend": "tsc -backend",
    "build:frontend": "tsc -b frontend",
    "build:cli": "tsc -b cli"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valeriya13/millennium-falcon-challenge.git"
  },
  "keywords": [],
  "author": "Valeriya Lebedev <lebedev.valeriya@gmail.com>",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/valeriya13/millennium-falcon-challenge/issues"
  },
  "homepage": "https://github.com/valeriya13/millennium-falcon-challenge#readme",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.16"
  }
}
