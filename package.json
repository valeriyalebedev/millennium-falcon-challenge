{
  "name": "millennium-falcon-challenge",
  "version": "1.0.0",
  "description": "Millenium falcon challenge solution",
  "main": "index.js",
  "workspaces": [
    "backend",
    "frontend",
    "cli"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:debug": "concurrently \"npm run dev:backend:debug\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:backend:debug": "npm --prefix backend run dev:debug",
    "dev:frontend": "npm --prefix frontend start",
    "test": "npm run test:backend && npm run test:frontend && npm run test:cli",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:cli": "npm --prefix cli test",
    "build": "npm run build:backend && npm run build:frontend && npm run build:cli",
    "build:backend": "npm --prefix backend build",
    "build:frontend": "npm --prefix frontend build",
    "build:cli": "npm --prefix cli build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valeriya13/millennium-falcon-challenge.git"
  },
  "keywords": [],
  "author": "Valeriya Lebedev <lebedev.valeriya@gmail.com>",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/valeriya13/millennium-falcon-challenge/issues"
  },
  "homepage": "https://github.com/valeriya13/millennium-falcon-challenge#readme",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0"
  }
}
